# ===== Gemini (chỉ ở backend, không log, không trả client) =====
# Nhiều key cách nhau dấu phẩy -> xoay vòng khi 429
GEMINI_API_KEY=
# gemini | fake  (fake = giả lập offline, chỉ để test luồng, KHÔNG phản ánh độ chính xác thật)
GEMINI_PROVIDER=gemini
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_RERANK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Với model 3.x: minimal|low|medium|high ; để trống với 2.5 (thinking tắt mặc định)
GEMINI_THINKING_LEVEL=minimal
EMBED_DIM=768
UNDERSTAND_TIMEOUT_MS=1200
EMBED_TIMEOUT_MS=800
RERANK_TIMEOUT_MS=2500
OFFLINE_TIMEOUT_MS=60000

# ===== Database =====
POSTGRES_USER=semsearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=semsearch
DATABASE_URL=postgresql://semsearch:change-me@db:5432/semsearch

# ===== Auth =====
# Key cho bot gọi /search (để trống = mở, chỉ dùng khi dev)
API_KEYS=
# Key cho /v1/admin, evaluate, calibrate (BẮT BUỘC khi deploy)
ADMIN_KEYS=
# Bật "Xem khóa" cho khóa bảng tạo mới. Khóa Fernet 32 byte, URL-safe base64.
# Giữ bí mật, sao lưu riêng và dùng cùng giá trị trên mọi worker; trống = chỉ lưu hash.
TABLE_KEY_ENCRYPTION_KEY=

# ===== Cache =====
RESPONSE_CACHE_TTL=600
UNDERSTAND_CACHE_TTL=3600
EMBED_CACHE_TTL=86400

# Giới hạn tốc độ job offline (free tier embed: 100 văn bản/phút)
EMBED_DOC_RPM=90
# Offline: limite chung cho mọi bảng trong 1 process; không suy ra quota thực từ con số này.
EMBED_BATCH_SIZE=30
EMBED_CONCURRENCY=1
JOB_CONCURRENCY=2
LLM_OFFLINE_RPM=30
PERSISTENT_CACHE_ONLINE=false
LLM_RPM_LIMIT=0
UNDERSTAND_SOFT_DEADLINE_MS=0
SEARCH_DEADLINE_MS=1800
RERANK_MIN_BUDGET_MS=900
RERANK_EXPECTED_MS=1300

# ===== GPT (OpenAI-compatible) – dự phòng khi Gemini hết quota =====
# Trống key = TẮT hoàn toàn (không đổi hành vi hiện tại).
# - LLM (understand/rerank/...): tự chuyển GPT khi Gemini 429 / hết quota / breaker mở.
# - Embedding: KHÔNG trộn 2 không gian vector. Khi ingest gặp hết quota, bảng được đổi
#   sang OPENAI_EMBED_MODEL và embed lại toàn bộ (query cũng dùng model mới).
OPENAI_API_KEY=
# Nói chuẩn OpenAI nên đổi được sang proxy/gateway khác (OpenRouter, Azure style...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
# text-embedding-3-small hỗ trợ dimensions=EMBED_DIM(768) -> cùng kích thước với Gemini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Giới hạn request embed GPT/phút (0 = tự xoay key khi 429)
OPENAI_EMBED_RPM=0
# false = bỏ qua GPT kể cả khi có key
GPT_FALLBACK=true

# Tài khoản đăng nhập tạo sẵn (để trống = tắt, chạy chế độ mở)
SEED_ACCOUNT_EMAIL=
SEED_ACCOUNT_PASSWORD=
SEED_ACCOUNT_NAME=
SEED_ACCOUNT_PHONE=
# Đăng nhập Google: OAuth Client ID (…apps.googleusercontent.com). Trống = ẩn nút Google.
GOOGLE_CLIENT_ID=
# true = đăng nhập Google lần đầu tự tạo tài khoản (non-admin); false = chỉ tài khoản đã có
GOOGLE_ALLOW_SIGNUP=true

# ===== Meta Model API — LLM dự phòng thứ ba: Gemini -> GPT -> Meta =====
# Backend only. Không dùng Meta để tạo embedding.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_LLM_MODEL=muse-spark-1.3
META_FALLBACK=true

# ===== OpenRouter — LLM dự phòng (OpenAI-compatible) =====
# Backend only, không dùng để tạo embedding. Tự xoay giữa các model trong danh sách
# (cách nhau dấu phẩy) khi 1 model hết quota / bị rate limit / trả output lỗi.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free
OPENROUTER_FALLBACK=true
