# ===== .env cho server THẬT (đổi tên thành .env khi deploy) =====
# Gemini (nhiều key cách nhau dấu phẩy; nên dùng paid tier cho production)
GEMINI_API_KEY=
GEMINI_PROVIDER=gemini
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_RERANK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_THINKING_LEVEL=minimal
EMBED_DIM=768
SEARCH_DEADLINE_MS=1800

# Database: TRỎ VÀO service 'db' của docker-compose (không phải localhost)
POSTGRES_USER=semsearch
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH
POSTGRES_DB=semsearch
DATABASE_URL=postgresql://semsearch:DOI_MAT_KHAU_MANH@db:5432/semsearch

# Tài khoản quản trị tạo sẵn (đổi mật khẩu mạnh!)
SEED_ACCOUNT_EMAIL=giangnh@vihatgroup.com
SEED_ACCOUNT_PASSWORD=DOI_MAT_KHAU_MANH
SEED_ACCOUNT_NAME=Giang Nguyen
SEED_ACCOUNT_PHONE=0357778534
# Đăng nhập Google (tuỳ chọn): tạo OAuth Client ID ở Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_ALLOW_SIGNUP=true

# Khoá API toàn cục cho super-admin (tuỳ chọn)
ADMIN_KEYS=
API_KEYS=
