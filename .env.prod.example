# ===== .env cho server THẬT (đổi tên thành .env khi deploy) =====
# Gemini (nhiều key cách nhau dấu phẩy; nên dùng paid tier cho production)
GEMINI_API_KEY=
GEMINI_PROVIDER=gemini
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_RERANK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_THINKING_LEVEL=minimal
EMBED_DIM=768
SEARCH_DEADLINE_MS=1800
EMBED_BATCH_SIZE=30
EMBED_CONCURRENCY=1
JOB_CONCURRENCY=2

# Database: TRỎ VÀO service 'db' của docker-compose (không phải localhost)
POSTGRES_USER=semsearch
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH
POSTGRES_DB=semsearch
DATABASE_URL=postgresql://semsearch:DOI_MAT_KHAU_MANH@db:5432/semsearch

# Tài khoản quản trị tạo sẵn (đổi mật khẩu mạnh!)
SEED_ACCOUNT_EMAIL=giangnh@vihatgroup.com
SEED_ACCOUNT_PASSWORD=DOI_MAT_KHAU_MANH
SEED_ACCOUNT_NAME=Giang Nguyen
SEED_ACCOUNT_PHONE=0357778534
# Đăng nhập Google (tuỳ chọn): tạo OAuth Client ID ở Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_ALLOW_SIGNUP=true

# Khoá API toàn cục cho super-admin (tuỳ chọn)
ADMIN_KEYS=
API_KEYS=

# ===== GPT (OpenAI-compatible) – dự phòng khi Gemini hết quota =====
# Trống key = tắt. LLM tự chuyển GPT khi Gemini hết quota;
# embed thì bảng được đổi sang model GPT và embed lại (không trộn 2 không gian vector).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_RPM=0
GPT_FALLBACK=true

# ===== OpenRouter — LLM dự phòng (OpenAI-compatible), tự xoay model khi hết quota =====
# Backend only, không dùng để tạo embedding.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free
OPENROUTER_FALLBACK=true
